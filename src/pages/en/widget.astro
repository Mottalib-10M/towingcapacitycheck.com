---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/towing-capacity-checker/" title="Towing capacity checker: truck, trailer, payload, GVWR and GCWR" width="100%" height="1000" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the towing capacity checker on your site, free" description="RV clubs, boat ramps, campgrounds and trailer forums can embed the towing capacity checker with one iframe line. No cookie, no tracking, no dealer offer inside the frame." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed the checker', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed the checker' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed the towing capacity checker</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code. When a maker publishes a new towing guide and we load it, the frame on your page shows the new ratings.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <p>Terms: keep the credit line under the checker visible, leave the frame as it is, and do not set it beside a financing or dealer lead form. The frame sets no cookie and reports nothing about your visitors to us. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
    <h2>Truck or SUV, trailer, five weight limits</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/towing-capacity-checker/" title="Towing capacity checker" width="100%" height="1000" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
