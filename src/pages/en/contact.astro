---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { CONTACT_EMAIL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { contactPageSchema } from '../../lib/seo';
const lang = 'en';
const path = route('contact', lang);
const description = 'Write to Towing Capacity Check about a rating, a towing guide or a spec sheet that changed. E-mail only: no quote, no dealer, nothing passed on to a seller.';
---
<PageLayout title="Contact Towing Capacity Check: report a rating that changed" description={description} lang={lang} noindex={true} jsonLd={[contactPageSchema({ name: 'Contact', description, path, lang })]} breadcrumbs={[{ label: 'Contact' }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none prose-headings:font-serif">
    <h1>Contact</h1>
    <p>By e-mail: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. No form, no phone line. Dealer and RV lot pages about towing capacity usually end with a request for your number; this site keeps nothing and forwards nothing.</p>
    <h2>Messages that help</h2>
    <ul>
      <li>A new or revised towing guide, trailering chart or spec sheet from Ford, Chevrolet, Ram, Jeep, Kia or Toyota: send the link and the page that changed.</li>
      <li>A row of our tables that does not match the maker's document: name the model year, the configuration and the page.</li>
      <li>A vehicle you would like covered, with the address of the maker's own document that rates it (dealer brochures and forum posts cannot be used).</li>
      <li>Embedding the checker on an RV club, campground or boat club page: the code is on the <a href={route('widget', lang)}>embed page</a>.</li>
    </ul>
    <h2>What we cannot do</h2>
    <p>We cannot say whether your own truck, with its options and the hitch on it, is safe to tow a given trailer: the labels on its door pillar, its owner's manual and a public scale decide that. We do not sell vehicles, hitches or trailers and do not refer anyone to a dealer.</p>
    <h2>Publisher</h2>
    <LegalIdentity lang={lang} />
  </div>
</PageLayout>
